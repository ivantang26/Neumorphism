{
  "name": "thermo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Thermo: a (fictional) smart home hub. Neumorphic landing page and accessible control dashboard for heating, lights and blinds.",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:contrast && astro build && npm run check:budget",
    "preview": "tsx scripts/serve.ts",
