---
import Logo from "./Logo.astro";
import { ButtonLink } from "~/ui/Button";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/how-it-works", label: "How it works" },
  { href: "/support", label: "Support" },
];
---
<header class="nav wrap">
  <a href="/" class="brand" aria-label="Thermo home">
    <Logo />
    <span>Thermo</span>
  </a>
  <nav aria-label="Main">
    <ul class="links" role="list">
      {links.map((l) => (
        <li><a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
  <ButtonLink href="/pre-order" variant="primary" className="cta">Pre-order</ButtonLink>
  <details class="menu">
    <summary>Menu</summary>
    <ul role="list">
      {links.map((l) => (
        <li><a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a></li>
      ))}
      <li><a href="/app">Dashboard demo</a></li>
    </ul>
  </details>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: var(--target);
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
  }
  nav {
    margin-left: auto;
  }
  .links {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a,
  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 1rem;
    border-radius: var(--radius-control);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .links a[aria-current="page"],
  .menu a[aria-current="page"] {
    box-shadow: var(--pressed-sm);
    color: var(--cool-ink);
  }

  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 1.125rem;
    border-radius: var(--radius-control);
    border: var(--bw) solid var(--edge-strong);
    box-shadow: var(--shadow);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] summary {
    box-shadow: var(--pressed-sm);
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    z-index: 20;
    display: grid;
    gap: 0.25rem;
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    border-radius: var(--radius-card);
    background: var(--base);
    border: var(--bw) solid var(--edge-strong);
    box-shadow: var(--raised);
  }
  .menu a {
    width: 100%;
  }

  @media (max-width: 699px) {
    nav {
      display: none;
    }
    .nav :global(.cta) {
      margin-left: auto;
    }
    .menu {
      display: block;
    }
    .nav {
      gap: 0.75rem;
    }
  }
</style>
